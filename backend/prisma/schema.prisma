datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   // MANAGER, SAFETY, ANALYST, DRIVER
  name         String
  createdAt    DateTime @default(now())
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  vin             String   @unique
  licensePlate    String   @unique
  name            String
  make            String
  model           String
  year            Int
  capacity        Float    // in kg
  fuelType        String   // Diesel, CNG, Electric, LNG
  purchaseDate    String
  insuranceExpiry String
  fitnessExpiry   String
  permitExpiry    String
  currentOdometer Float    // in km
  status          String   // ACTIVE, IN_SERVICE, MAINTENANCE, OUT_OF_SERVICE
  driverId        Int?
}

model Driver {
  id                           Int     @id @default(autoincrement())
  name                         String
  phone                        String
  email                        String  @unique
  address                      String
  licenseNumber                String
  licenseExpiry                String
  joiningDate                  String
  experienceYears              Int
  status                       String  // AVAILABLE, IN_TRANSIT, ON_REST, SUSPENDED
  vehicleId                    Int?
  emergencyContactName         String
  emergencyContactRelationship String
  emergencyContactPhone        String
  performanceScore             Int     @default(90)
}

model Trip {
  id                   Int     @id @default(autoincrement())
  tripNumber           String  @unique
  vehicleId            Int
  driverId             Int
  origin               String
  destination          String
  departureDate        String
  departureTime        String
  estimatedArrivalDate String
  estimatedArrivalTime String
  cargoType            String
  cargoWeight          Float
  priority             String  // LOW, MEDIUM, HIGH
  notes                String?
  status               String  // SCHEDULED, IN_TRANSIT, COMPLETED, CANCELLED
  timelineJson         String  // Stringified JSON timeline events

  // Completed metrics
  distanceCovered Float?
  fuelUsed        Float?
  remarks         String?
  completedTime   String?

  // Cancelled metrics
  cancelReason  String?
  cancelComment String?
}

model MaintenanceLog {
  id            Int     @id @default(autoincrement())
  vehicleId     Int
  serviceType   String
  description   String
  estimatedCost Float
  scheduledDate String
  priority      String  // LOW, MEDIUM, HIGH
  status        String  // PENDING, IN_PROGRESS, COMPLETED
}

model DvirLog {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  driverId  Int
  date      String
  status    String  // PASS, FAIL
  remarks   String?
}

model IncidentLog {
  id          Int     @id @default(autoincrement())
  vehicleId   Int
  driverId    Int
  date        String
  description String
  severity    String  // LOW, MEDIUM, HIGH
  status      String  // UNDER_REVIEW, RESOLVED
}

model ExpenseLog {
  id           Int     @id @default(autoincrement())
  date         String
  vehicleId    Int
  driverId     Int
  amount       Float
  category     String  // Fuel, Maintenance, Tolls, Lodging
  volumeLitres Float?  // Liter amount for fuel only
  location     String
  notes        String?
}
